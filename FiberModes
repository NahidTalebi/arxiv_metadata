Iprime=@(n_m,x) -besseli(n_m+1,x)+n_m./x.*besseli(n_m,x);

for ll=1:length(la)
    disp(ll)
    
    k0=2*pi/la(ll);
    w=k0*c;
    
    K1=sqrt(-epsr1(ll)*k0.^2+kk.^2);
    K2=sqrt(-epsr2(ll)*k0.^2+kk.^2);
    K3=sqrt(-epsr3(ll)*k0.^2+kk.^2);

    A11=(K2.^2-K1.^2)./(1i*w*eps_0*epsr2(ll)).*n_m.*kk./r1.*besseli(n_m,K2.*r1).*besseli(n_m,K1.*r1);
    A12=(K2.^2-K1.^2)./(1i*w*eps_0*epsr2(ll)).*n_m.*kk./r1.*besselk(n_m,K2.*r1).*besseli(n_m,K1.*r1);
    A13=K2.*K1.*(K2.*Iprime(n_m,K1*r1).*besseli(n_m,K2.*r1)-K1.*Iprime(n_m,K2.*r1).*besseli(n_m,K1.*r1));
    A14=K2.*K1.*(K2.*Iprime(n_m,K1*r1).*besselk(n_m,K2.*r1)-K1.*Kprime(n_m,K2.*r1).*besseli(n_m,K1.*r1));

    A21=(K2.^2-K3.^2)./(1i*w*eps_0*epsr2(ll)).*n_m.*kk./r2.*besseli(n_m,K2.*r2).*besselk(n_m,K3.*r2);
    A22=(K2.^2-K3.^2)./(1i*w*eps_0*epsr2(ll)).*n_m.*kk./r2.*besselk(n_m,K2.*r2).*besselk(n_m,K3.*r2);
    A23=K2.*K3.*(K2.*besseli(n_m,K2.*r2).*Kprime(n_m,K3.*r2)-K3.*Iprime(n_m,K2.*r2).*besselk(n_m,K3.*r2));
    A24=K2.*K3.*(K2.*besselk(n_m,K2.*r2).*Kprime(n_m,K3.*r2)-K3.*Kprime(n_m,K2.*r2).*besselk(n_m,K3.*r2));

    A31=K1.*K2.*(-epsr1(ll)./epsr2(ll).*K2.*Iprime(n_m,K1.*r1).*besseli(n_m,K2.*r1)+K1.*Iprime(n_m,K2.*r1).*besseli(n_m,K1.*r1));
    A32=K1.*K2.*(-epsr1(ll)./epsr2(ll).*K2.*Iprime(n_m,K1.*r1).*besselk(n_m,K2.*r1)+K1.*Kprime(n_m,K2.*r1).*besseli(n_m,K1.*r1));
    A33=(K2.^2-K1.^2).*n_m.*kk./(1i*w*miu*r1).*besseli(n_m,K2.*r1).*besseli(n_m,K1*r1);
    A34=(K2.^2-K1.^2).*n_m.*kk./(1i*w*miu*r1).*besselk(n_m,K2.*r1).*besseli(n_m,K1*r1);

    A41=K2.*K3.*(-epsr3(ll)./epsr2(ll).*K2.*Kprime(n_m,K3.*r2).*besseli(n_m,K2.*r2)+K3.*Iprime(n_m,K2.*r2).*besselk(n_m,K3.*r2));
    A42=K2.*K3.*(-epsr3(ll)./epsr2(ll).*K2.*Kprime(n_m,K3.*r2).*besselk(n_m,K2.*r2)+K3.*Kprime(n_m,K2.*r2).*besselk(n_m,K3.*r2));
    A43=(K2.^2-K3.^2).*n_m.*kk./(1i*w*miu*r2).*besseli(n_m,K2.*r2).*besselk(n_m,K3*r2);
    A44=(K2.^2-K3.^2).*n_m.*kk./(1i*w*miu*r2).*besselk(n_m,K2.*r2).*besselk(n_m,K3*r2);

    Det_ =...
    abs(A11.*A22.*A33.*A44 - A11.*A22.*A34.*A43 - A11.*A23.*A32.*A44 + A11.*A23.*A34.*A42 + A11.*A24.*A32.*A43 - A11.*A24.*A33.*A42 - A12.*A21.*A33.*A44 + A12.*A21.*A34.*A43 + A12.*A23.*A31.*A44 - A12.*A23.*A34.*A41 - A12.*A24.*A31.*A43 + A12.*A24.*A33.*A41 + A13.*A21.*A32.*A44 - A13.*A21.*A34.*A42 - A13.*A22.*A31.*A44 + A13.*A22.*A34.*A41 + A13.*A24.*A31.*A42 - A13.*A24.*A32.*A41 - A14.*A21.*A32.*A43 + A14.*A21.*A33.*A42 + A14.*A22.*A31.*A43 - A14.*A22.*A33.*A41 - A14.*A23.*A31.*A42 + A14.*A23.*A32.*A41);

    figure(1); imagesc(beta1.*1e-6,alpha1*1e-6,log(abs(Det_.'))); shading flat; axis tight
    set(gcf,'Renderer','ZBuffer')
    % caxis([0,0.1*m])
    xlim([-0.1,30]); ylim([-0.1,30]);

    N_B_=0;
    for nn=2:length(alpha1)-1
        for mm=2:length(beta1)-1
            %% TMx
            %%even modes
            F1=Det_(mm,nn+1)-Det_(mm,nn);
            F2=Det_(mm,nn-1)-Det_(mm,nn);

            F3=Det_(mm+1,nn)-Det_(mm,nn);
            F4=Det_(mm-1,nn)-Det_(mm,nn);

            F5=Det_(mm-1,nn-1)-Det_(mm,nn);
            F6=Det_(mm-1,nn+1)-Det_(mm,nn);

            F7=Det_(mm+1,nn-1)-Det_(mm,nn);
            F8=Det_(mm+1,nn+1)-Det_(mm,nn);
            
            if F1>=0 && F2>=0 && F3>=0 && F4>=0 && F5>=0 && F6>=0 && F7>=0 && F8>=0
                    N_B_=N_B_+1;
                    betar_(ll,N_B_)=beta1(mm)+1i*alpha1(nn);
            end
        end
    end

    figure(1); hold on; plot(real(betar_(ll,:)).*1e-6,imag(betar_(ll,:)).*1e-6,'ow','Markersize',8)
    F_fy(ll)=getframe;
    hold off;

end

